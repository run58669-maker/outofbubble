{
  "name": "out-of-the-bubble",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Qloo-powered cross-category discovery agent.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs",
